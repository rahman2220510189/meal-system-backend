# ───────────────────────────────────────────────────────────────
#  Meal System — backend settings
#  Copy this file to ".env" (npm run setup does it for you)
# ───────────────────────────────────────────────────────────────

# Neon → Connect → "Connection pooling" ON  (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon → Connect → "Connection pooling" OFF (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Long random text used to sign logins. npm run setup fills this in automatically.
JWT_SECRET="CHANGE_ME"

# Where the website runs. Several allowed: separate with commas.
FRONTEND_URL="http://localhost:3000"

PORT=4000

# Optional — receipt photos (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
